{
  "LambdaFunctionConfigurations": [
    {
      "Id": "FaceVisionUploadTrigger",
      "LambdaFunctionArn": "arn:aws:lambda:us-east-1:663981373457:function:facevision-face-counter",
      "Events": [
        "s3:ObjectCreated:*"
      ],
      "Filter": {
        "Key": {
          "FilterRules": [
            {
              "Name": "prefix",
              "Value": "uploads/"
            }
          ]
        }
      }
    }
  ]
}
